# Settings of the Docker deployment. install.sh writes a real `.env` from this list (mode 0600, never committed);
# copy this file to `.env` and fill it in by hand if you do not use install.sh. Nothing in this file is a secret.

# --- required ---------------------------------------------------------------
# The domain computers reach the server at, and the matching public URL (add :port if HTTPS is not on 443).
CC_DOMAIN=cloud.example.org
CC_PUBLIC_URL=https://cloud.example.org

# --- TLS ---------------------------------------------------------------------
# acme (Let's Encrypt), internal (Caddy's own CA, for tests) or custom (files in CC_TLS_DIR).
CC_TLS_MODE=acme
CC_ACME_EMAIL=
CC_TLS_DIR=./tls
CC_HTTP_PORT=80
CC_HTTPS_PORT=443

# --- image -------------------------------------------------------------------
CC_IMAGE=craft-cloud:local
CC_VERSION=0.0.0
CC_REVISION=unknown
CC_INSTALL_DIR=/opt/craft-cloud
# Opt-in: on makes the update-check service ask api.github.com every 12 hours whether a newer Craft Cloud exists
# (it sends only a Craft-Cloud/<version> User-Agent). off, the default, makes no request. CC_UPDATE_REPO also sets the
# repository the admin banner links to.
CC_UPDATE_CHECK=off
CC_UPDATE_REPO=itrycodinganditsbad/craft-cloud
CC_UPDATE_CHANNEL=release
CC_UPDATE_BRANCH=main

# --- networks ------------------------------------------------------------------
# Caddy's fixed address on the internal frontend network. The server believes X-Forwarded-For from this address only
# (trusted_proxies takes single addresses, no networks), so it must lie inside CC_FRONTEND_SUBNET.
CC_FRONTEND_SUBNET=172.29.215.0/24
CC_CADDY_IP=172.29.215.2
# Where the other containers get their addresses from: inside CC_FRONTEND_SUBNET, and not containing CC_CADDY_IP.
CC_FRONTEND_POOL=172.29.215.128/25
CC_EDGE_SUBNET=172.29.216.0/24

# --- secrets (the Postgres profile; install.sh fills them with random values) -----------------------------------
# Only characters A-Z a-z 0-9 . _ ~ - and at least 32 of them: the database password becomes part of a database URL.
CC_SECRET_DB_SUPERUSER_PASSWORD=
CC_SECRET_DB_PASSWORD=

# --- S3 storage (compose.s3.yaml) ----------------------------------------------------------------------------
CC_S3_BUCKET=
CC_S3_PREFIX=
CC_S3_REGION=us-east-1
# Leave empty for Amazon S3; set it for MinIO and other S3-compatible services.
CC_S3_ENDPOINT=
CC_S3_ALLOW_HTTP=false
CC_SECRET_S3_ACCESS_KEY_ID=
CC_SECRET_S3_SECRET_ACCESS_KEY=
