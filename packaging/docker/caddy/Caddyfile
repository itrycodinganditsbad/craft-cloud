# Reverse proxy of the Docker deployment: TLS in front of craft-cloud-server, which speaks plain HTTP only.
#
# CC_DOMAIN, CC_PUBLIC_URL, CC_TLS_MODE and CC_ACME_EMAIL come from the Compose environment:
#   acme      a public certificate from Let's Encrypt (the domain must resolve here, ports 80 and 443 be reachable)
#   internal  a certificate from Caddy's own CA, for local tests (browsers warn)
#   custom    your own certificate: fullchain.pem and private.key in the directory CC_TLS_DIR

{
	# Not exposed: the admin API listens on loopback inside this container only.
	admin localhost:2019
	# Caddy cannot install its internal CA into a read-only container and would log an error about it.
	skip_install_trust
	email "{$CC_ACME_EMAIL}"

	# Caddy logs a failed request (an upstream error, for example) with its full URI, which would hold an invite code
	# (/join/<code>) and any query. The log keeps neither the URI nor the headers (Authorization, Cookie).
	log {
		output stderr
		format filter {
			wrap console
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}

	servers {
		timeouts {
			# The server cuts off slow request bodies itself, but asks the proxy to bound the request headers.
			read_header 10s
		}
	}
}

# Plain HTTP: redirect to the configured public URL, which keeps a port other than 443. An explicit site for the HTTP
# address replaces Caddy's automatic redirect, which would drop the port. ACME HTTP challenges are answered before this.
http://{$CC_DOMAIN} {
	redir {$CC_PUBLIC_URL}{uri} 308
}

{$CC_DOMAIN} {
	import tls-{$CC_TLS_MODE}.caddy

	# Only fills in the generic headers where the server sent none (the leading `?`). HSTS comes from the tls file of
	# a real certificate; a test certificate must not pin the browser to HTTPS.
	header {
		?X-Content-Type-Options "nosniff"
		-Server
	}

	# No `request_body { max_size ... }` on purpose: uploads are streamed and the server limits each route itself.
	reverse_proxy server:8080 {
		# Pass response bytes on at once: downloads stream and nothing is held back.
		flush_interval -1

		# Send requests only while the server answers its info endpoint.
		health_uri /api/info
		health_status 200
		health_interval 10s
		health_timeout 3s

		transport http {
			dial_timeout 5s
			# The time until the server starts to answer; there is no limit on how long a body takes to transfer.
			response_header_timeout 60s
		}
	}

	# No access log on purpose: a log of full URLs would keep invite codes (/join/<code>). The error log above leaves
	# out the URI and the headers. If you add an access log, filter them out the same way.
}
