<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by Craft Cloud (`craft-cloud-agent autostart on`); `autostart off` removes it. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ch.craftcloud.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/zoë/Library/Application Support/Craft Cloud &amp; Co/craft-cloud-agent</string>
        <string>run</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/zoë/Library/Application Support/craft-cloud-agent/run.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/zoë/Library/Application Support/craft-cloud-agent/run.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
</dict>
</plist>
